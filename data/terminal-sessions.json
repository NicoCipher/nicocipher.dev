  {
    "id": "linux-permissions",
    "label": "case-study · infrastructure",
    "title": "Debugging chmod Script Failures",
    "link": "/publications/case-study/linux-permissions",
    "commands": [
      { "prompt": "$", "command": "ls -l backup.sh", "output": "-rwxr--r--  1 nico nico  220 Jun 19 09:14 backup.sh" },
      { "prompt": "$", "command": "./backup.sh", "output": "bash: ./backup.sh: Permission denied" },
      { "prompt": "$", "command": "chmod 744 backup.sh && ./backup.sh", "output": "Backup completed successfully." }
    ]
  }
]
